+// <INPUT_PARAMS_CATEGORY>/<TEST_SUITE_NAME>.<TEST_NAME>
+//   ~ <TEST_NAME_FOR_ALL_ABOVE>
+//
+// AlignmentOfZeroCases/ScalarRoundUpFailureTest.<TEST_NAME>
+//   ~ ThrowsInvalidArgumentOnRoundUp
+//
+// AlignmentOfOneCases/ScalarIdentityRoundUpTest.<TEST_NAME>
+// ZeroValueCases/ScalarIdentityRoundUpTest.<TEST_NAME>
+//   ~ ReturnsSameValuePostRoundUp
+//
+// PrealignedCases/ScalarRoundUpTest.<TEST_NAME>
+// MisalignedCases/ScalarRoundUpTest.<TEST_NAME>
+// PowerOfTwoAlignCases/ScalarRoundUpTest.<TEST_NAME>
+// PowerOfTenAlignCases/ScalarRoundUpTest.<TEST_NAME>
