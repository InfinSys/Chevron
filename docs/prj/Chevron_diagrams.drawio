        </mxCell>
        <mxCell id="q7oF20PaZOX7hIM9F14Q-156" edge="1" parent="TkyqAQc8ZbELkbN2UzGK-1" source="q7oF20PaZOX7hIM9F14Q-155" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="q7oF20PaZOX7hIM9F14Q-152">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q7oF20PaZOX7hIM9F14Q-155" parent="TkyqAQc8ZbELkbN2UzGK-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Individual thread execution constructs are &lt;b&gt;reusable&lt;/b&gt; by design to avoid system calls. When current resources are all busy we can then allocate new reusable threads of execution while abiding by a budget.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- (worker-threads have work queues and wait for work when none)&lt;/div&gt;&lt;div&gt;- (loop-threads can wait for a loop to be assigned [loop stacking option?])&lt;/div&gt;&lt;div&gt;- (all thread execution constructs have the ability to idle at little-to-no cost)&lt;/div&gt;&lt;div&gt;- (all thread execution constructs indicate their execution status)&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="440" x="-10120" y="-1320" as="geometry" />
        </mxCell>
        <mxCell id="q7oF20PaZOX7hIM9F14Q-157" parent="TkyqAQc8ZbELkbN2UzGK-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;color: light-dark(rgb(51, 153, 255), rgb(51, 153, 255));&quot;&gt;RMC &lt;/font&gt;Library&lt;div&gt;(&lt;font style=&quot;color: light-dark(rgb(255, 203, 107), rgb(255, 203, 107));&quot;&gt;Resource Management Constructs&lt;/font&gt;)&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="250" x="-9770" y="-2340" as="geometry" />
        </mxCell>
        <mxCell id="q7oF20PaZOX7hIM9F14Q-158" parent="TkyqAQc8ZbELkbN2UzGK-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="There are &lt;b&gt;&lt;u&gt;TWO&lt;/u&gt;&lt;/b&gt; types of memory providers:&lt;div&gt;&lt;br&gt;&lt;div&gt;- One that politics directly with the OS&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; (&lt;i&gt;AND&lt;/i&gt;)&lt;/div&gt;&lt;div&gt;- One that politics with another memory provider&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="350" x="-9370" y="-1900" as="geometry" />
        </mxCell>
        <mxCell id="q7oF20PaZOX7hIM9F14Q-159" parent="TkyqAQc8ZbELkbN2UzGK-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="There are &lt;b&gt;&lt;u&gt;TWO&lt;/u&gt;&lt;/b&gt; types of resource providers:&lt;div&gt;&lt;br&gt;&lt;div&gt;- One that politics directly with the OS&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; (&lt;i&gt;AND&lt;/i&gt;)&lt;/div&gt;&lt;div&gt;- One that politics with another resource provider&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="350" x="-9040" y="-1900" as="geometry" />
        </mxCell>
        <mxCell id="q7oF20PaZOX7hIM9F14Q-161" edge="1" parent="TkyqAQc8ZbELkbN2UzGK-1" source="q7oF20PaZOX7hIM9F14Q-160" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="q7oF20PaZOX7hIM9F14Q-159">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q7oF20PaZOX7hIM9F14Q-160" parent="TkyqAQc8ZbELkbN2UzGK-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="A &lt;font style=&quot;color: light-dark(rgb(255, 203, 107), rgb(255, 203, 107));&quot;&gt;top-level resource provider&lt;/font&gt; directly interacts with the necessary facilities to organize the overall coordination and distribution of resources for resource consumers downstream. This kind of provider is servicing a process-wide range of application components.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The &lt;font style=&quot;color: light-dark(rgb(255, 203, 107), rgb(255, 203, 107));&quot;&gt;scoped resource providers&lt;/font&gt; interact with their immediate resource provider to acquire resources and organize the coordination and distribution of resources for consumers within its scope. This kind of provider is servicing a focused subset of application components.&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="330" x="-9055" y="-1705" as="geometry" />
        </mxCell>
        <mxCell id="q7oF20PaZOX7hIM9F14Q-163" edge="1" parent="TkyqAQc8ZbELkbN2UzGK-1" source="q7oF20PaZOX7hIM9F14Q-162" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="q7oF20PaZOX7hIM9F14Q-160">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q7oF20PaZOX7hIM9F14Q-162" parent="TkyqAQc8ZbELkbN2UzGK-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Scoped resource providers are designed such that a reference to another instance is used as the backing resource provider, in a sort of recursive design.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- (scoped resource providers are authoritative over the resources within their scope)&lt;/div&gt;&lt;div&gt;- (the scoped resource provider API is designed with chaining in mind)&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="400" x="-9080" y="-1445" as="geometry" />
        </mxCell>
        <mxCell id="q7oF20PaZOX7hIM9F14Q-164" parent="TkyqAQc8ZbELkbN2UzGK-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Maybe threads should be able to be a worker or a loop under the same class???" vertex="1">
          <mxGeometry height="90" width="250" x="-10280" y="2370" as="geometry" />
        </mxCell>
        <mxCell id="q7oF20PaZOX7hIM9F14Q-165" parent="TkyqAQc8ZbELkbN2UzGK-1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;font style=&quot;font-size: 30px; font-weight: 700;&quot; color=&quot;#82aaff&quot;&gt;chevron&lt;/font&gt;&lt;span style=&quot;font-size: 30px; font-weight: 700;&quot;&gt;::&lt;/span&gt;&lt;font style=&quot;font-size: 30px; font-weight: 700;&quot; color=&quot;#82aaff&quot;&gt;thread&lt;/font&gt;&lt;span style=&quot;font-size: 30px; font-weight: 700;&quot;&gt;::&lt;/span&gt;&lt;font style=&quot;font-size: 30px; font-weight: 700;&quot; color=&quot;#ffcb6b&quot;&gt;ThreadingScope&lt;/font&gt;&lt;font style=&quot;font-size: 30px; font-weight: 700;&quot; color=&quot;#c792ea&quot;&gt;;&lt;/font&gt;" vertex="1">
