#!/usr/bin/env bash

# -----------------------------------------------------------------------------
# Strict Mode
#          -e: Exit immediately if a command exits with a non-zero status.
#          -u: Treat unset variables as an error.
# -o pipefail: The return value of a pipeline is the status of the last command
#              to exit with a non-zero status.
# -----------------------------------------------------------------------------
set -euo pipefail

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Project root is one level above the scripts directory
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$PROJECT_ROOT" || exit 1

# ANSI color codes for readable output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m' # No Color

log_info() { echo -e "${YELLOW}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

# Dependency Validation:
# Fail immediately if the required tools aren't in the PATH.
for cmd in rg; do
    if ! command -v "$cmd" &> /dev/null; then
        log_error "Dependency missing: '$cmd' is not installed or not in PATH."
        exit 1
    fi
done

# One source of truth for the trees scanned below; add or remove a directory
# here to update all reports.
readonly SOURCE_DIRS=(include src lib cmake)

# Incomplete marker patterns.
readonly IMPL_PATTERN='INCOMPLETE IMPL'
readonly DOC_PATTERN='INCOMPLETE DOC'

# List of incomplete work report sections.
# Each entry binds its header to its single criterion.
readonly SECTIONS=(
    "INCOMPLETE SOURCE:$IMPL_PATTERN"
    "INCOMPLETE DOCUMENTATION:$DOC_PATTERN"
)

# Match layout and styling mirror a direct rg run: grouped by file with
# colors when stdout is a tty, flat plain records when piped or redirected.
COLOR_FLAG=auto
HEADING_FLAG=--no-heading
[[ -t 1 ]] && COLOR_FLAG=always && HEADING_FLAG=--heading

# Buffer each report so a header only appears when its section has matches.
# The trap guarantees scratch file is removed on any exit.
TMP_FILE="$(mktemp)"
trap 'rm -f "$TMP_FILE"' EXIT

TOTAL_FOUND=0

# Print an incomplete work report section.
report_section() {
    local section="$1" header pattern rc=0
    header="${section%%:*}"
    pattern="${section#*:}"

    if rg --color="$COLOR_FLAG" "$HEADING_FLAG" -n "$pattern" "${SOURCE_DIRS[@]}" > "$TMP_FILE"; then
        if (( TOTAL_FOUND > 0 )); then
            echo -e "\n\n${YELLOW}[${header}]${NC}:"
        else
            echo -e "${YELLOW}[${header}]${NC}:"
        fi
        cat "$TMP_FILE"
        TOTAL_FOUND=$((TOTAL_FOUND + 1))
    else
        rc=$?
        if (( rc == 2 )); then
            log_error "ripgrep failed while scanning '${SOURCE_DIRS[*]}'"
            exit 1
        fi
    fi
}

for section in "${SECTIONS[@]}"; do
    report_section "$section"
done

if (( TOTAL_FOUND == 0 )); then
    log_success "No incomplete work markers found. All clear!"
fi
